<a href="/allPosts">&larr;</a>
<div class="admin-title">
  <h2><%= locals.title %></h2>
  <form action="/delete/<%= data.id %>?_method=DELETE" method="post">
    <input type="submit" value="삭제" class="btn-delete btn">
  </form>
</div>

<form action="/edit/<%= data.id %>?_method=PUT" method="post">
  <label for="title"><b>제목</b></label>
  <input type="text" name="title" id="title" value="<%= data.title %>">

  <label for="body"><b>내용</b></label>
  <textarea name="body" id="body" cols="50" rows="10">
    <%= data.body %>
  </textarea>

  <input type="submit" value="수정" class="btn">
</form>